// The pending changes of a workspace (T131): files grouped by changelist, picking, the commit
// box with recent messages, and the changelist dialogs. The Rust side (src/changes.rs and
// src/app.rs) builds the rows and runs the operations.

import { Validation } from "validation.slint";
import { Reading, DiffPanel } from "history.slint";
import { Team } from "team.slint";
import { Branching } from "branches.slint";
import { Button, LineEdit, TextEdit, ListView, ProgressIndicator, Palette, ScrollView } from "std-widgets.slint";
import { ErrorInfo, ErrorBanner, Card, Muted, Title, FormLabel, Check, DialogButtons } from "parts.slint";

/// What the changes view asks of the window beyond its own callbacks.
export global Changes {
    callback unpick-all();
}

/// One row of the list: a group's header or a file.
export struct ChangeRow {
    is-group: bool,
    /// The group's key, or the file's path.
    key: string,
    /// The group's title, or the file's name.
    title: string,
    /// The folder part of the file's path, with its trailing slash.
    dir: string,
    /// Files in the group.
    count: int,
    /// The changelist's description (groups).
    description: string,
    /// A named changelist, which has its own actions (groups).
    named: bool,
    /// modified, added, deleted, missing, conflicted or untracked (files).
    status: string,
    /// What the file holds, for its icon: code, text, image, audio, video, model, archive or other.
    file-kind: string,
    /// "moved from …", "locked", "needs lock" (files).
    tags: string,
    picked: bool,
    selected: bool,
}

/// The selected file, for the details panel.
export struct FileDetails {
    shown: bool,
    path: string,
    name: string,
    status: string,
    status-text: string,
    copy: string,
    changelist: string,
    lock: string,
    locked: bool,
}

export struct ChangesState {
    loaded: bool,
    total: int,
    picked: int,
    /// What runs now ("Committing", "Reverting" …), or empty.
    busy: string,
    progress: float,
    progress-text: string,
    error: ErrorInfo,
    /// Files the server refused, one per line.
    refused: string,
    /// "Committed r12 (3 files)." and the like.
    done: string,
    conflicted: int,
    /// "Merging main r3..r5" while a merge waits for the commit, else empty.
    merging: string,
    details: FileDetails,
}

/// What a changelist or revert dialog is about.
export struct ListDialogState {
    /// The changelist it acts on.
    name: string,
    /// The new name, or the commit message.
    value: string,
    description: string,
    files: int,
    /// Picked files that "New changelist" can move into the new one.
    picked: int,
    move-picked: bool,
    /// What a revert loses, in words.
    what: string,
    busy: bool,
    error: ErrorInfo,
    refused: string,
}

/// A changelist files can be moved to.
export struct MoveTarget {
    name: string,
    label: string,
}

component KindIcon inherits Rectangle {
    in property <string> kind;
    width: 30px;
    height: 18px;
    border-radius: 3px;
    background: root.kind == "image" ? #8b5cf6
        : root.kind == "code" ? #2563eb
        : root.kind == "text" ? #64748b
        : root.kind == "audio" ? #db2777
        : root.kind == "video" ? #ea580c
        : root.kind == "model" ? #0d9488
        : root.kind == "archive" ? #a16207
        : #6b7280;
    accessible-role: none;
    Text {
        text: root.kind == "image" ? "IMG"
            : root.kind == "code" ? "CODE"
            : root.kind == "text" ? "TXT"
            : root.kind == "audio" ? "SND"
            : root.kind == "video" ? "VID"
            : root.kind == "model" ? "3D"
            : root.kind == "archive" ? "ZIP"
            : "BIN";
        font-size: 8px;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StatusLetter inherits Rectangle {
    in property <string> status;
    width: 18px;
    accessible-role: none;
    Text {
        text: root.status == "modified" ? "M"
            : root.status == "added" ? "A"
            : root.status == "deleted" ? "D"
            : root.status == "missing" ? "!"
            : root.status == "conflicted" ? "C"
            : "?";
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.status == "modified" ? #3b82f6
            : root.status == "added" ? #16a34a
            : root.status == "deleted" || root.status == "conflicted" ? #dc2626
            : root.status == "missing" ? #ea580c
            : Palette.foreground.transparentize(0.4);
    }
}

/// A small button for the bars.
component BarButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> enabled: true;
    in property <bool> primary;
    callback clicked();
    min-height: 26px;
    width: t.preferred-width + 14px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 24px;
        border-radius: 5px;
        border-width: root.primary ? 0 : 1px;
        border-color: Palette.border;
        background: root.primary ? Palette.accent-background
            : touch.has-hover && root.enabled ? Palette.alternate-background : Palette.background;
        opacity: root.enabled ? 1 : 0.45;
        touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
        t := Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.primary ? 600 : 400;
            color: root.primary ? Palette.accent-foreground : Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component GroupHeader inherits Rectangle {
    in property <ChangeRow> item;
    in property <bool> busy;
    in property <bool> can-commit;
    callback toggle();
    callback commit();
    callback rename();
    callback delete();
    height: 32px;
    background: transparent;
    accessible-role: none;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Check {
            y: (parent.height - self.height) / 2;
            checked: root.item.picked;
            enabled: root.item.count > 0;
            accessible-label: "Pick all of " + root.item.title;
            toggled => { root.toggle(); }
        }
        Text { text: root.item.title; font-weight: 600; color: Palette.foreground; vertical-alignment: center; }
        Muted { text: root.item.count; vertical-alignment: center; }
        Muted {
            text: root.item.description;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.named: HorizontalLayout {
            spacing: 4px;
            BarButton {
                text: "Shelve…";
                accessible-label: "Shelve changelist " + root.item.key;
                enabled: !root.busy && root.item.count > 0;
                clicked => { Team.shelve-changelist(root.item.key); }
            }
            BarButton {
                text: "Commit…";
                accessible-label: "Commit changelist " + root.item.key;
                enabled: !root.busy && root.item.count > 0 && root.can-commit;
                clicked => { root.commit(); }
            }
            BarButton {
                text: "Rename…";
                accessible-label: "Rename changelist " + root.item.key;
                enabled: !root.busy;
                clicked => { root.rename(); }
            }
            BarButton {
                text: "Delete…";
                accessible-label: "Delete changelist " + root.item.key;
                enabled: !root.busy;
                clicked => { root.delete(); }
            }
        }
    }
}

component FileRow inherits Rectangle {
    in property <ChangeRow> item;
    callback toggle();
    callback select();
    height: 28px;
    background: root.item.selected ? Palette.accent-background.transparentize(0.75)
        : touch.has-hover ? Palette.alternate-background : transparent;
    accessible-role: list-item;
    accessible-label: root.item.key;
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;
    accessible-action-default => { root.select(); }
    touch := TouchArea { clicked => { root.select(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Check {
            y: (parent.height - self.height) / 2;
            checked: root.item.picked;
            accessible-label: "Pick " + root.item.key;
            toggled => { root.toggle(); }
        }
        StatusLetter { status: root.item.status; }
        KindIcon { kind: root.item.file-kind; y: (parent.height - self.height) / 2; }
        HorizontalLayout {
            horizontal-stretch: 1;
            Muted { text: root.item.dir; vertical-alignment: center; accessible-role: none; }
            Text {
                text: root.item.title;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }
        if root.item.tags != "": Muted {
            text: root.item.tags;
            font-size: 11px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component DetailLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 4px;
    Muted { text: root.label + ":"; font-size: 12px; accessible-role: none; }
    Text {
        text: root.value;
        font-size: 12px;
        color: Palette.foreground;
        accessible-role: text;
        accessible-label: root.label;
        accessible-value: root.value;
    }
}

/// The grey bar over a list, with its name, a count and its actions.
component PaneHeader inherits Rectangle {
    in property <string> title;
    in property <string> count;
    height: 32px;
    background: Palette.alternate-background;
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 6px;
        Text { text: root.title; font-weight: 600; font-size: 12px; vertical-alignment: center; color: Palette.foreground.transparentize(0.2); accessible-role: none; }
        Muted { text: root.count; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; accessible-role: none; }
        @children
    }
}

/// The pending changes, laid out like a file status screen: the files to commit over the rest,
/// the selected file's diff beside them, and the commit box along the bottom.
export component ChangesView inherits Rectangle {
    in property <ChangesState> state;
    in property <[ChangeRow]> picked-rows;
    in property <[ChangeRow]> pending-rows;
    in-out property <string> message;
    callback toggle-file(string);
    callback toggle-group(string);
    callback toggle-all();
    callback select-file(string);
    callback refresh();
    callback new-changelist();
    callback commit-changelist(string);
    callback rename-changelist(string);
    callback delete-changelist(string);
    callback commit();
    callback recent-messages();
    callback add-selected();
    callback revert-selected();
    callback move-selected();
    callback dismiss-error();
    property <bool> idle: root.state.busy == "";
    property <FileDetails> d: root.state.details;

    VerticalLayout {
        if Validation.python-warning != "": HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            Muted { text: Validation.python-warning; wrap: word-wrap; horizontal-stretch: 1; }
            Button { text: "Python help"; clicked => { Validation.help(); } }
            Button { text: "Dismiss"; clicked => { Validation.python-warning = ""; } }
        }
        if root.state.merging != "": Rectangle {
            background: Palette.accent-background.transparentize(0.85);
            height: merge-line.preferred-height;
            merge-line := HorizontalLayout {
                padding: 8px;
                padding-left: 12px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.state.merging + ". The next commit records the merge and takes every change.";
                    wrap: word-wrap;
                    vertical-alignment: center;
                    color: Palette.foreground;
                    accessible-role: text;
                    accessible-label: "Pending merge";
                    accessible-value: self.text;
                }
                Button {
                    text: "Abandon merge";
                    enabled: root.idle;
                    clicked => { Branching.abandon-merge(); }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            // The two lists.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 480px;
                Rectangle { x: parent.width - 1px; width: 1px; background: Palette.border; }
                VerticalLayout {
                    PaneHeader {
                        title: "To commit";
                        count: root.state.picked > 0 ? "· " + root.state.picked : "";
                        BarButton {
                            text: "Unpick all";
                            enabled: root.state.picked > 0;
                            clicked => { Changes.unpick-all(); }
                        }
                    }
                    if root.picked-rows.length == 0: HorizontalLayout {
                        padding-left: 12px;
                        Muted {
                            text: root.state.total == 0 ? "" : "Tick files below to commit them.";
                            height: 36px;
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.picked-rows: FileRow {
                            item: row;
                            toggle => { root.toggle-file(row.key); }
                            select => { root.select-file(row.key); }
                        }
                    }
                    PaneHeader {
                        title: "Pending";
                        count: root.state.total == 0 ? "" : "· " + (root.state.total - root.state.picked);
                        Check {
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            checked: root.state.total > 0 && root.state.picked == root.state.total;
                            enabled: root.state.total > 0;
                            accessible-label: "Pick all files";
                            toggled => { root.toggle-all(); }
                        }
                        Muted { text: "Pick all"; font-size: 12px; vertical-alignment: center; accessible-role: none; }
                        BarButton { text: "New changelist…"; enabled: root.idle; clicked => { root.new-changelist(); } }
                        BarButton { text: "Refresh"; enabled: root.idle; clicked => { root.refresh(); } }
                    }
                    if root.state.loaded && root.state.total == 0: HorizontalLayout {
                        padding: 12px;
                        Muted {
                            text: "No changes. Edit files in the workspace folder and they show up here.";
                            wrap: word-wrap;
                        }
                    }
                    ListView {
                        vertical-stretch: 1.4;
                        for row in root.pending-rows: VerticalLayout {
                            if row.is-group: GroupHeader {
                                item: row;
                                busy: !root.idle;
                                can-commit: root.state.merging == "" && root.state.conflicted == 0;
                                toggle => { root.toggle-group(row.key); }
                                commit => { root.commit-changelist(row.key); }
                                rename => { root.rename-changelist(row.key); }
                                delete => { root.delete-changelist(row.key); }
                            }
                            if !row.is-group: FileRow {
                                item: row;
                                toggle => { root.toggle-file(row.key); }
                                select => { root.select-file(row.key); }
                            }
                        }
                    }
                }
            }
            // The selected file: what it is, what can be done with it, and its diff.
            VerticalLayout {
                horizontal-stretch: 1;
                if root.d.shown: Rectangle {
                    height: file-bar.preferred-height;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    file-bar := VerticalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 14px;
                            DetailLine { label: "Status"; value: root.d.status-text; }
                            if root.d.copy != "": DetailLine { label: "From"; value: root.d.copy; }
                            DetailLine { label: "Changelist"; value: root.d.changelist; }
                            DetailLine { label: "Lock"; value: root.d.lock; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            if root.d.status == "untracked": BarButton { text: "Add"; enabled: root.idle; clicked => { root.add-selected(); } }
                            if root.d.status == "conflicted": BarButton {
                                text: "Resolve…";
                                primary: true;
                                label: "Resolve " + root.d.path;
                                clicked => { Branching.resolve(root.d.path); }
                            }
                            if root.d.status != "untracked": BarButton { text: "Revert…"; enabled: root.idle; clicked => { root.revert-selected(); } }
                            if root.d.status != "untracked": BarButton {
                                text: "Move to…";
                                label: "Move to changelist";
                                enabled: root.idle;
                                clicked => { root.move-selected(); }
                            }
                            if root.d.status != "untracked" && root.d.status != "added" && root.d.locked: BarButton {
                                text: "Unlock";
                                label: "Unlock " + root.d.path;
                                enabled: root.idle;
                                clicked => { Team.unlock-selected(); }
                            }
                            if root.d.status != "untracked" && root.d.status != "added" && !root.d.locked: BarButton {
                                text: "Lock…";
                                label: "Lock " + root.d.path;
                                enabled: root.idle;
                                clicked => { Team.lock-selected(); }
                            }
                            if root.d.status != "untracked" && root.d.status != "added": BarButton {
                                text: "History";
                                label: "History of " + root.d.path;
                                clicked => { Reading.file-history(root.d.path); }
                            }
                            if root.d.status != "untracked" && root.d.status != "added": BarButton {
                                text: "Blame";
                                label: "Blame " + root.d.path;
                                clicked => { Reading.blame-file(root.d.path, -1); }
                            }
                            if root.d.status != "untracked": BarButton {
                                text: "Open diff";
                                label: "Diff of " + root.d.path;
                                clicked => { Reading.diff-file(root.d.path, -1); }
                            }
                        }
                    }
                }
                if root.d.shown && root.d.status == "untracked": HorizontalLayout {
                    padding: 12px;
                    vertical-stretch: 1;
                    Muted {
                        text: "Not added yet. Add it to commit it, or leave it out of the depot.";
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
                if !(root.d.shown && root.d.status == "untracked"): DiffPanel {
                    vertical-stretch: 1;
                    shown: root.d.shown && Reading.diff.path == root.d.path;
                    empty: root.state.total == 0 ? "" : "Select a file to see its diff, add it, revert it or move it to a changelist.";
                }
            }
        }
        // The commit box.
        Rectangle {
            height: box.preferred-height;
            Rectangle { y: 0; height: 1px; background: Palette.border; }
            box := VerticalLayout {
                padding: 10px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    TextEdit {
                        accessible-label: "Commit message";
                        placeholder-text: "Describe what changed";
                        text <=> root.message;
                        enabled: root.state.busy != "Committing";
                        min-height: 64px;
                        vertical-stretch: 0;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        alignment: end;
                        Button {
                            text: "Check changes";
                            enabled: root.idle && (root.state.picked > 0 || root.d.shown);
                            clicked => { Validation.check(); }
                        }
                        Button {
                            text: "Recent messages…";
                            enabled: root.idle;
                            clicked => { root.recent-messages(); }
                        }
                        Button {
                            text: root.state.busy == "Committing" ? "Committing…"
                                : root.state.merging != "" ? "Commit merge"
                                : "Commit " + root.state.picked + (root.state.picked == 1 ? " file" : " files");
                            primary: true;
                            enabled: root.idle
                                && (root.state.merging != "" || root.state.picked > 0)
                                && root.message != ""
                                && root.state.conflicted == 0;
                            clicked => { root.commit(); }
                        }
                    }
                }
                if root.state.busy == "Committing": VerticalLayout {
                    spacing: 4px;
                    ProgressIndicator {
                        indeterminate: root.state.progress < 0;
                        progress: max(root.state.progress, 0);
                        accessible-label: "Progress";
                    }
                    Muted { text: root.state.progress-text; }
                }
                if root.state.error.shown: ErrorBanner {
                    error: root.state.error;
                    dismissable: true;
                    dismissed => { root.dismiss-error(); }
                }
                if root.state.refused != "": Text {
                    text: root.state.refused;
                    font-family: Reading.mono;
                    color: Palette.foreground;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Files the server refused";
                    accessible-value: self.text;
                }
                if root.state.conflicted > 0: Text {
                    text: root.state.conflicted == 1
                        ? "Resolve the conflicted file before you commit."
                        : "Resolve " + root.state.conflicted + " conflicted files before you commit.";
                    color: #dc2626;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Why commit is off";
                    accessible-value: self.text;
                }
                if root.state.done != "": Text {
                    text: root.state.done;
                    color: #16a34a;
                    accessible-role: text;
                    accessible-label: "Done";
                    accessible-value: self.text;
                }
            }
        }
    }
}

export component NewChangelistDialog inherits Card {
    in-out property <ListDialogState> state;
    callback submit();
    callback close();
    width: 460px;
    accessible-role: groupbox;
    accessible-label: "New changelist";
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: "New changelist"; }
        FormLabel { text: "Name"; }
        LineEdit {
            accessible-label: "Name";
            placeholder-text: "harbor-lights";
            text: root.state.value;
            edited(t) => { root.state.value = t; }
            accepted => { root.submit(); }
        }
        Muted { text: "Letters, digits, dots, dashes and underscores."; font-size: 11px; }
        FormLabel { text: "Description"; }
        LineEdit {
            accessible-label: "Description";
            placeholder-text: "Used as the commit message when you commit the changelist";
            text: root.state.description;
            edited(t) => { root.state.description = t; }
            accepted => { root.submit(); }
        }
        if root.state.picked > 0: HorizontalLayout {
            spacing: 8px;
            Check {
                checked: root.state.move-picked;
                accessible-label: "Move the picked files into it";
                toggled => { root.state.move-picked = !root.state.move-picked; }
            }
            Text {
                text: "Move the " + root.state.picked + (root.state.picked == 1 ? " picked file" : " picked files") + " into it";
                color: Palette.foreground;
                accessible-role: none;
            }
        }
        if root.state.error.shown: ErrorBanner { error: root.state.error; }
        DialogButtons {
            confirm: "Create";
            busy: root.state.busy;
            enabled: root.state.value != "";
            confirmed => { root.submit(); }
            cancelled => { root.close(); }
        }
    }
}

export component RenameChangelistDialog inherits Card {
    in-out property <ListDialogState> state;
    callback submit();
    callback close();
    width: 460px;
    accessible-role: groupbox;
    accessible-label: "Rename changelist";
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: "Rename changelist " + root.state.name; }
        FormLabel { text: "New name"; }
        LineEdit {
            accessible-label: "New name";
            text: root.state.value;
            edited(t) => { root.state.value = t; }
            accepted => { root.submit(); }
        }
        Muted { text: "Its files and description move with it."; font-size: 11px; }
        if root.state.error.shown: ErrorBanner { error: root.state.error; }
        DialogButtons {
            confirm: "Rename";
            busy: root.state.busy;
            enabled: root.state.value != "" && root.state.value != root.state.name;
            confirmed => { root.submit(); }
            cancelled => { root.close(); }
        }
    }
}

export component CommitChangelistDialog inherits Card {
    in-out property <ListDialogState> state;
    callback submit();
    callback close();
    width: 520px;
    accessible-role: groupbox;
    accessible-label: "Commit changelist";
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: "Commit changelist " + root.state.name; }
        Muted {
            text: "Commits exactly the " + root.state.files + (root.state.files == 1 ? " file" : " files") + " in " + root.state.name + ", whatever else is picked.";
            wrap: word-wrap;
        }
        FormLabel { text: "Message"; }
        LineEdit {
            accessible-label: "Message";
            text: root.state.value;
            edited(t) => { root.state.value = t; }
            accepted => { root.submit(); }
        }
        if root.state.error.shown: ErrorBanner { error: root.state.error; }
        if root.state.refused != "": Text {
            text: root.state.refused;
            font-family: "monospace";
            color: Palette.foreground;
            accessible-role: text;
            accessible-label: "Files the server refused";
            accessible-value: self.text;
        }
        DialogButtons {
            confirm: root.state.busy ? "Committing…" : "Commit " + root.state.files + (root.state.files == 1 ? " file" : " files");
            busy: root.state.busy;
            enabled: root.state.value != "";
            confirmed => { root.submit(); }
            cancelled => { root.close(); }
        }
    }
}

export component ConfirmDialog inherits Card {
    in property <string> title;
    in property <string> body;
    in property <string> confirm;
    in property <ListDialogState> state;
    callback submit();
    callback close();
    width: 460px;
    accessible-role: groupbox;
    accessible-label: root.title;
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Title { text: root.title; }
        Text {
            text: root.body;
            wrap: word-wrap;
            color: Palette.foreground;
            accessible-role: text;
            accessible-label: "Question";
            accessible-value: self.text;
        }
        if root.state.error.shown: ErrorBanner { error: root.state.error; }
        DialogButtons {
            confirm: root.confirm;
            busy: root.state.busy;
            confirmed => { root.submit(); }
            cancelled => { root.close(); }
        }
    }
}

export component MoveDialog inherits Card {
    in property <[MoveTarget]> targets;
    in property <ListDialogState> state;
    callback move(string);
    callback close();
    width: 420px;
    accessible-role: groupbox;
    accessible-label: "Move to changelist";
    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        Title { text: "Move to changelist"; }
        Muted { text: root.state.what; wrap: word-wrap; }
        for t in root.targets: Button {
            text: t.label;
            accessible-label: "Move to " + t.label;
            enabled: !root.state.busy;
            clicked => { root.move(t.name); }
        }
        if root.targets.length == 0: Muted { text: "There is no other changelist. Make one with New changelist."; wrap: word-wrap; }
        if root.state.error.shown: ErrorBanner { error: root.state.error; }
        HorizontalLayout {
            alignment: end;
            Button { text: "Cancel"; clicked => { root.close(); } }
        }
    }
}

export component MessagesDialog inherits Card {
    in property <[string]> messages;
    callback pick(string);
    callback close();
    width: 520px;
    accessible-role: groupbox;
    accessible-label: "Recent messages";
    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        Title { text: "Recent messages"; }
        if root.messages.length == 0: Muted { text: "Messages you commit with show up here."; }
        for m in root.messages: Button {
            text: m;
            accessible-label: "Use message " + m;
            clicked => { root.pick(m); }
        }
        HorizontalLayout {
            alignment: end;
            Button { text: "Cancel"; clicked => { root.close(); } }
        }
    }
}
