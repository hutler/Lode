// Lode Desk's mark: a rounded square in the accent colours, with a seam of ore across it.

export component Logo inherits Rectangle {
    in property <length> size: 36px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.25;
    background: @linear-gradient(135deg, #3f6df2 0%, #7a5af5 100%);
    accessible-role: none;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M5 15c3-1 4-5 7-5s4 3 7 2";
        stroke: #ffffffd0;
        stroke-width: root.size / 14;
        fill: transparent;
    }
}
