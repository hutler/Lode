// Lode Desk's own line icons, drawn as paths on a 24 × 24 grid so they take the theme's colour.

import { Palette } from "std-widgets.slint";

/// The paths, by name.
export global Icons {
    out property <string> commit: "M3 12h5.5M15.5 12H21M15.5 12a3.5 3.5 0 1 1-7 0a3.5 3.5 0 1 1 7 0";
    out property <string> update: "M12 4v11M7 10l5 5l5-5M5 20h14";
    out property <string> shelve: "M3 4h18v5H3zM5 9v10h14V9M10 13h4";
    out property <string> unshelve: "M3 15h18v5H3zM12 12V3M8 7l4-4l4 4";
    out property <string> lock: "M5 11h14v9H5zM8 11V8a4 4 0 0 1 8 0v3";
    out property <string> branch: "M8 6a2 2 0 1 1-4 0a2 2 0 1 1 4 0M8 18a2 2 0 1 1-4 0a2 2 0 1 1 4 0M20 7a2 2 0 1 1-4 0a2 2 0 1 1 4 0M6 8v8M18 9c0 5-7 4-11 7.5";
    out property <string> merge: "M8 5a2 2 0 1 1-4 0a2 2 0 1 1 4 0M8 19a2 2 0 1 1-4 0a2 2 0 1 1 4 0M20 12a2 2 0 1 1-4 0a2 2 0 1 1 4 0M6 7v10M6 7c0 4 5 5 10 5";
    out property <string> revert: "M9 14L4 9l5-5M4 9h10a6 6 0 0 1 0 12h-3";
    out property <string> refresh: "M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7";
    out property <string> folder: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
    out property <string> changes: "M4 5h16M4 12h16M4 19h10";
    out property <string> history: "M20 12a8 8 0 1 1-16 0a8 8 0 1 1 16 0M12 8v4l3 2";
    out property <string> eye: "M2 12s4-7 10-7s10 7 10 7s-4 7-10 7S2 12 2 12zM15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0";
    out property <string> list: "M5 3h14v18H5zM9 8h6M9 12h6M9 16h3";
    out property <string> branch-small: "M8 6a2 2 0 1 1-4 0a2 2 0 1 1 4 0M8 18a2 2 0 1 1-4 0a2 2 0 1 1 4 0M6 8v8";
    out property <string> server: "M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01";
}

/// One icon in the foreground colour (or `tint`).
export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Palette.foreground;
    in property <length> size: 22px;
    width: root.size;
    height: root.size;
    commands: root.name;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 1.6px;
    fill: transparent;
    accessible-role: none;
}
