// Native depot browser and asset inspector.
import { Button, ListView, Palette } from "std-widgets.slint";
import { Muted, Title } from "parts.slint";
import { AssetSearch } from "asset_search.slint";
import { KindIcon } from "changes.slint";
import { Icon, Icons } from "icons.slint";
export struct DepotFolder { path: string, caption: string, depth: int, parent-index: int, expanded: bool }
export struct AssetCard { path: string, name: string, kind: string, picture: image, preview: bool, local: bool, writable: bool, size: string, holder: string, mine: bool, comment: string, workspace: string }
export global Assets {
    in-out property <[DepotFolder]> folders;
    in-out property <[AssetCard]> rows;
    in-out property <AssetCard> selected;
    in-out property <string> folder;
    in-out property <string> message;
    in-out property <string> page-label;
    in-out property <bool> previous;
    in-out property <bool> next;
    in-out property <bool> busy;
    in-out property <bool> lock-known;
    in-out property <bool> local-only;
    in-out property <int> tree-index;
    callback browse(string);
    callback toggle(string);
    callback pick(string);
    in-out property <bool> watching;
    callback watch();
    callback refresh();
    callback change-page(int);
    callback scope(bool);
    callback take();
    callback release();
}
export component DepotTree inherits VerticalLayout {
    in property <string> depot;
    in property <bool> active;
    Button { text: "Find asset…"; accessible-label: "Find asset in depot"; clicked => { AssetSearch.open(); } }
    HorizontalLayout {
        Button { text: "Depot"; checkable: true; checked: !Assets.local-only; clicked => { Assets.scope(false); } }
        Button { text: "Workspace"; checkable: true; checked: Assets.local-only; clicked => { Assets.scope(true); } }
    }
    tree := FocusScope {
        height: min(max(1, Assets.folders.length), 9) * 25px;
        accessible-role: list; accessible-label: "Depot folders";
        in property <int> cursor-index: Assets.tree-index;
        changed cursor-index => {
            if self.cursor-index * 25px < -folder-list.content-y {
                folder-list.content-y = -self.cursor-index * 25px;
            } else if (self.cursor-index + 1) * 25px > -folder-list.content-y + folder-list.visible-height {
                folder-list.content-y = min(0px, folder-list.visible-height - (self.cursor-index + 1) * 25px);
            }
        }
        function cursor(i: int) {
            if i >= 0 && i < Assets.folders.length { Assets.tree-index = i; }
        }
        key-pressed(e) => {
            if Assets.folders.length == 0 { return reject; }
            if e.text == Key.DownArrow { self.cursor(Assets.tree-index + 1); return accept; }
            if e.text == Key.UpArrow { self.cursor(Assets.tree-index - 1); return accept; }
            if e.text == Key.Home { self.cursor(0); return accept; }
            if e.text == Key.End { self.cursor(Assets.folders.length - 1); return accept; }
            if e.text == Key.RightArrow {
                if !Assets.folders[Assets.tree-index].expanded { Assets.toggle(Assets.folders[Assets.tree-index].path); }
                else if Assets.tree-index + 1 < Assets.folders.length && Assets.folders[Assets.tree-index + 1].depth > Assets.folders[Assets.tree-index].depth {
                    self.cursor(Assets.tree-index + 1);
                }
                return accept;
            }
            if e.text == Key.LeftArrow {
                if Assets.folders[Assets.tree-index].expanded { Assets.toggle(Assets.folders[Assets.tree-index].path); }
                else { self.cursor(Assets.folders[Assets.tree-index].parent-index); }
                return accept;
            }
            if e.text == Key.Return || e.text == " " { Assets.browse(Assets.folders[Assets.tree-index].path); return accept; }
            return reject;
        }
        folder-list := ListView {
            for f[i] in Assets.folders: Rectangle {
                height: 25px;
                background: Assets.folder == f.path && root.active ? Palette.accent-background.transparentize(0.76)
                    : row-hit.has-hover ? Palette.alternate-background : transparent;
                border-width: tree.has-focus && Assets.tree-index == i ? 1px : 0px;
                border-color: Palette.accent-background;
                accessible-role: list-item; accessible-label: f.path == "" ? "Browse depot root" : "Browse folder " + f.path;
                accessible-item-selectable: true; accessible-item-selected: root.active && Assets.folder == f.path;
                accessible-action-default => { tree.focus(); tree.cursor(i); Assets.browse(f.path); }
                row-hit := TouchArea { clicked => { tree.focus(); tree.cursor(i); Assets.browse(f.path); } }
                HorizontalLayout {
                    padding-left: min(f.depth * 12px, 96px); padding-right: 4px; spacing: 3px;
                    Rectangle {
                        width: 18px; height: 25px;
                        accessible-role: button; accessible-label: (f.expanded ? "Collapse folder " : "Expand folder ") + (f.path == "" ? root.depot : f.path);
                        accessible-action-default => { tree.focus(); tree.cursor(i); Assets.toggle(f.path); }
                        Icon {
                            name: f.expanded ? "M5 9l7 7 7-7" : "M9 5l7 7-7 7";
                            size: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        }
                        TouchArea { clicked => { tree.focus(); tree.cursor(i); Assets.toggle(f.path); } }
                    }
                    Icon { name: Icons.folder; size: 14px; tint: Palette.foreground.transparentize(0.22); y: (parent.height - self.height) / 2; }
                    Text { text: f.path == "" ? root.depot : f.caption; color: Palette.foreground; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}
component AssetRow inherits Rectangle {
    in property <AssetCard> asset;
    height: 30px;
    border-radius: 5px;
    background: Assets.selected.path == asset.path ? Palette.accent-background.transparentize(0.75)
        : touch.has-hover ? Palette.alternate-background : transparent;
    accessible-role: list-item;
    accessible-label: "Inspect " + asset.path;
    accessible-item-selectable: true;
    accessible-item-selected: Assets.selected.path == asset.path;
    accessible-action-default => { Assets.pick(asset.path); }
    touch := TouchArea { clicked => { Assets.pick(root.asset.path); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        KindIcon { kind: root.asset.kind; y: (parent.height - self.height) / 2; }
        Text {
            text: root.asset.name;
            color: Palette.foreground;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        if root.asset.holder != "": HorizontalLayout {
            spacing: 4px;
            Icon {
                name: Icons.lock;
                size: 13px;
                y: (parent.height - self.height) / 2;
                tint: root.asset.mine ? Palette.accent-background : #dc2626;
            }
            Muted {
                text: root.asset.mine ? "my lock" : root.asset.holder;
                font-size: 11.5px;
                vertical-alignment: center;
                color: root.asset.mine ? Palette.accent-background : #dc2626;
                accessible-role: none;
            }
        }
        Muted { text: root.asset.size; font-size: 11.5px; vertical-alignment: center; accessible-role: none; }
        Muted {
            text: root.asset.local ? "In workspace" : "Depot only";
            font-size: 11.5px;
            vertical-alignment: center;
            width: 90px;
            accessible-role: none;
        }
    }
}
export component AssetBrowser inherits VerticalLayout {
    padding: 10px; spacing: 8px;
    HorizontalLayout { Title { text: Assets.folder == "" ? "Depot files" : Assets.folder; horizontal-stretch: 1; }
        Button { text: "Refresh"; accessible-label: "Refresh depot folder"; enabled: !Assets.busy; clicked => { Assets.refresh(); } }
    }
    if Assets.message != "": Text { text: Assets.message; color: Palette.foreground; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 2;
            ListView {
                for asset in Assets.rows: AssetRow { asset: asset; }
            }
            HorizontalLayout { alignment: center; spacing: 5px;
                Button { text: "Previous"; enabled: Assets.previous && !Assets.busy; clicked => { Assets.change-page(-1); } }
                Muted { text: Assets.page-label; }
                Button { text: "Next"; enabled: Assets.next && !Assets.busy; clicked => { Assets.change-page(1); } }
            }
        }
        VerticalLayout { width: 212px; spacing: 8px; alignment: start;
            Title { text: "Inspector"; }
            if Assets.selected.path == "": Muted { text: "Select a file to inspect its editing access."; }
            if Assets.selected.path != "": VerticalLayout { spacing: 7px;
                Text { text: Assets.selected.path; color: Palette.foreground; wrap: word-wrap; }
                if Assets.selected.preview: Image { source: Assets.selected.picture; height: 100px; image-fit: contain; }
                Muted { text: Assets.selected.size + " · " + (!Assets.selected.local ? "Depot only" : Assets.selected.writable ? "Writable" : "Read-only"); }
                Text { text: !Assets.lock-known ? "Lock status unavailable" : Assets.selected.holder == "" ? "No lock held" : "Locked by " + Assets.selected.holder;
                    color: Palette.foreground; wrap: word-wrap; }
                if Assets.selected.workspace != "": Muted { text: "Workspace: " + Assets.selected.workspace; }
                if Assets.selected.comment != "": Text { text: Assets.selected.comment; color: Palette.foreground; wrap: word-wrap; }
                if Assets.lock-known && Assets.selected.holder != "" && !Assets.selected.mine: Button {
                    text: Assets.watching ? "Stop watching" : "Watch lock";
                    clicked => { Assets.watch(); }
                }
                if !Assets.selected.mine: Button { text: "Lock for editing"; enabled: Assets.lock-known && !Assets.busy && Assets.selected.local && Assets.selected.holder == "";
                    clicked => { Assets.take(); } }
                if Assets.selected.mine: Button { text: "Release my lock"; enabled: Assets.lock-known && !Assets.busy; clicked => { Assets.release(); } }
            }
        }
    }
}
