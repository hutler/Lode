// Locks, shelves and their checks (T133). The state lives in the global `Team`, which
// src/app/team.rs fills; the views draw it and call its callbacks.

import { Button, LineEdit, TextEdit, ListView, ComboBox, Palette } from "std-widgets.slint";
import { ErrorInfo, ErrorBanner, Card, Muted, Title, FormLabel, Check, DialogButtons } from "parts.slint";
import { CheckBadgeInfo, CheckRow, CheckBadge, ChecksList } from "checks.slint";
import { DiffRow, DiffRowView, Reading, StatusChip, SmallFact, CheckChip } from "history.slint";
import { Icon, Icons } from "icons.slint";
import { Links, CopyLinkButton } from "links.slint";

export struct LockRow {
    path: string,
    owner: string,
    agent: bool,
    mine: bool,
    workspace: string,
    since: string,
    comment: string,
}

export struct LocksState {
    loaded: bool,
    /// The server has no locks module.
    unavailable: bool,
    held: int,
    mine: int,
    busy: bool,
    error: ErrorInfo,
}

export struct LockDialogState {
    title: string,
    what: string,
    busy: bool,
    error: ErrorInfo,
    /// Who holds the files a refusal names, one per line.
    holders: string,
}

export struct ShelfRow {
    id: int,
    label: string,
    title: string,
    owner: string,
    you: bool,
    agent: bool,
    version: string,
    updated: string,
    checks: CheckBadgeInfo,
    selected: bool,
}

export struct ShelfFileRow {
    path: string,
    letter: string,
    status: string,
}

export struct ShelfDetail {
    shown: bool,
    id: int,
    version: int,
    title: string,
    body: string,
    subtitle: string,
    owner: string,
    branch: string,
    updated: string,
    submitted: string,
    merges: string,
    open: bool,
    mine: bool,
    deleted: bool,
    /// "Unshelving" while that runs.
    busy: string,
}

export struct ShelvesState {
    loaded: bool,
    unavailable: bool,
    /// all or mine.
    whose: string,
    /// open, submitted or deleted.
    state: string,
    error: ErrorInfo,
    notice: string,
    layout: string,
}

export struct ShelveDialogState {
    title: string,
    busy: bool,
    error: ErrorInfo,
}

export struct SubmitState {
    title: string,
    note: string,
    busy: bool,
    error: ErrorInfo,
    /// Required checks that have not passed, one per line.
    missing: string,
    /// The shelf changed since it was shown.
    stale: bool,
}

export struct UnshelvedState {
    title: string,
    counts: string,
    files: string,
    conflicts: bool,
}

export struct ConfirmState {
    title: string,
    body: string,
    confirm: string,
    busy: bool,
    error: ErrorInfo,
}

export global Team {
    in-out property <LocksState> locks;
    in property <[LockRow]> lock-rows;
    in-out property <string> lock-filter;
    in-out property <bool> mine-only;
    in-out property <LockDialogState> lock-dialog;
    in-out property <string> lock-comment;
    in-out property <ConfirmState> confirm;
    in-out property <ShelvesState> shelves;
    in property <[ShelfRow]> shelf-rows;
    in-out property <ShelfDetail> shelf;
    in property <[ShelfFileRow]> shelf-files;
    in property <[CheckRow]> shelf-checks;
    in property <[DiffRow]> shelf-diff;
    in-out property <ShelveDialogState> shelve;
    in-out property <string> shelve-text;
    in-out property <bool> shelve-keep;
    /// "A new shelf", then my open shelves.
    in property <[string]> shelve-targets;
    in-out property <int> shelve-target;
    in-out property <SubmitState> submit;
    in-out property <string> submit-text;
    in-out property <UnshelvedState> unshelved;
    callback refresh-locks();
    callback filter-locks();
    callback unlock(string);
    callback unlock-mine();
    callback ask-break(string);
    callback lock-selected();
    callback unlock-selected();
    callback submit-lock();
    callback confirmed();
    callback refresh-shelves();
    callback set-whose(string);
    callback set-state(string);
    callback select-shelf(int);
    callback unshelve();
    callback ask-submit();
    callback submit-shelf();
    callback review-new-version();
    callback ask-delete-shelf();
    callback shelve-picked();
    callback shelve-changelist(string);
    callback submit-shelve();
    callback target-chosen(int);
    callback set-layout(string);
    callback dismiss-error();
}

/// The bar over a team view: a title, a muted note, then the view's own controls.
component ViewBar inherits Rectangle {
    in property <string> title;
    in property <string> note;
    height: 44px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        Text {
            text: root.title;
            font-weight: 700;
            font-size: 14px;
            vertical-alignment: center;
            color: Palette.foreground;
            overflow: elide;
        }
        Muted { text: root.note; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        @children
    }
}

/// A column header strip.
component ColumnBar inherits Rectangle {
    height: 26px;
    background: Palette.alternate-background;
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
}

component ColumnName inherits Text {
    font-size: 11.5px;
    vertical-alignment: center;
    color: Palette.foreground.transparentize(0.4);
    overflow: elide;
    accessible-role: none;
}

/// A note inside a view, padded from its edges.
component ViewNote inherits HorizontalLayout {
    in property <string> text;
    padding: 12px;
    Muted { text: root.text; wrap: word-wrap; horizontal-stretch: 1; }
}

/// A compact on/off chip; a row of them works as a segmented filter.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 26px;
    width: t.preferred-width + 20px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.on ? Palette.accent-background : Palette.border;
    background: root.on ? Palette.accent-background.transparentize(0.85)
        : touch.has-hover ? Palette.alternate-background : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
    t := Text {
        text: root.text;
        font-size: 12px;
        font-weight: root.on ? 600 : 400;
        color: root.on ? Palette.accent-background : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component LockRowView inherits Rectangle {
    in property <LockRow> item;
    in property <bool> busy;
    in property <bool> odd;
    height: 36px;
    background: root.item.mine ? Palette.accent-background.transparentize(0.9)
        : root.odd ? Palette.alternate-background.transparentize(0.5) : transparent;
    accessible-role: list-item;
    accessible-label: root.item.path;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            name: Icons.lock;
            size: 16px;
            tint: root.item.mine ? Palette.accent-background : Palette.foreground.transparentize(0.45);
        }
        Text {
            text: root.item.path;
            horizontal-stretch: 3;
            preferred-width: 0px;
            min-width: 0px;
            font-family: Reading.mono;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground;
            accessible-role: none;
        }
        VerticalLayout {
            width: 150px;
            alignment: center;
            Text {
                text: (root.item.mine ? "you" : root.item.owner) + (root.item.agent ? " (agent)" : "");
                font-weight: root.item.mine ? 700 : 400;
                color: Palette.foreground;
                overflow: elide;
                accessible-role: text;
                accessible-label: "Held by";
                accessible-value: self.text;
            }
            if root.item.workspace != "": Muted { text: root.item.workspace; font-size: 10px; overflow: elide; font-family: Reading.mono; accessible-role: none; }
        }
        Muted { text: root.item.since; width: 150px; vertical-alignment: center; overflow: elide; accessible-role: none; }
        Muted {
            text: root.item.comment;
            horizontal-stretch: 2;
            preferred-width: 0px;
            min-width: 0px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Rectangle {
            width: 96px;
            if root.item.mine: Button {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: "Unlock";
                accessible-label: "Unlock " + root.item.path;
                enabled: !root.busy;
                clicked => { Team.unlock(root.item.path); }
            }
            if !root.item.mine: Button {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: "Break…";
                accessible-label: "Break lock on " + root.item.path;
                enabled: !root.busy;
                clicked => { Team.ask-break(root.item.path); }
            }
        }
    }
}

/// The branch's locks: who holds what, with unlock for mine and break for others'.
export component LocksView inherits Rectangle {
    in property <string> branch;
    VerticalLayout {
        ViewBar {
            title: "Locks on " + root.branch;
            note: Team.locks.loaded && !Team.locks.unavailable ? Team.locks.held + " held, " + Team.locks.mine + " by you" : "";
            LineEdit {
                width: 220px;
                placeholder-text: "Filter by path";
                accessible-label: "Filter by path";
                text <=> Team.lock-filter;
                edited => { Team.filter-locks(); }
            }
            HorizontalLayout {
                spacing: 6px;
                Check {
                    y: (parent.height - self.height) / 2;
                    checked: Team.mine-only;
                    accessible-label: "Only mine";
                    toggled => {
                        Team.mine-only = !Team.mine-only;
                        Team.filter-locks();
                    }
                }
                Text { text: "Only mine"; vertical-alignment: center; color: Palette.foreground; accessible-role: none; }
            }
            if Team.locks.mine > 1: Button {
                text: "Unlock all mine";
                enabled: !Team.locks.busy;
                clicked => { Team.unlock-mine(); }
            }
            Button { text: "Refresh"; enabled: !Team.locks.busy; clicked => { Team.refresh-locks(); } }
        }
        if Team.locks.error.shown: HorizontalLayout {
            padding: 12px;
            padding-bottom: 0;
            ErrorBanner {
                error: Team.locks.error;
                dismissable: true;
                dismissed => { Team.dismiss-error(); }
            }
        }
        if Team.locks.unavailable: ViewNote {
            text: "This server does not have the locks module, so files cannot be locked here.";
        }
        if !Team.locks.unavailable: ColumnBar {
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 10px;
                Rectangle { width: 16px; }
                ColumnName { text: "Path"; horizontal-stretch: 3; preferred-width: 0px; min-width: 0px; }
                ColumnName { text: "Held by"; width: 150px; }
                ColumnName { text: "Since"; width: 150px; }
                ColumnName { text: "Comment"; horizontal-stretch: 2; preferred-width: 0px; min-width: 0px; }
                Rectangle { width: 96px; }
            }
        }
        if Team.locks.loaded && !Team.locks.unavailable && Team.lock-rows.length == 0: ViewNote {
            text: Team.locks.held == 0 ? "Nobody holds a lock on this branch. Lock a file from Changes before you edit it, so nobody else commits it meanwhile." : "No lock matches.";
        }
        ListView {
            vertical-stretch: 1;
            for l[i] in Team.lock-rows: LockRowView { item: l; busy: Team.locks.busy; odd: Math.mod(i, 2) == 1; }
        }
    }
}

component ShelfRowView inherits Rectangle {
    in property <ShelfRow> item;
    height: 32px;
    background: root.item.selected ? Palette.accent-background.transparentize(0.75)
        : touch.has-hover ? Palette.alternate-background : transparent;
    accessible-role: list-item;
    accessible-label: "Shelf " + root.item.id + ": " + root.item.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;
    accessible-action-default => { Team.select-shelf(root.item.id); }
    touch := TouchArea { clicked => { Team.select-shelf(root.item.id); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            name: Icons.shelve;
            size: 16px;
            tint: root.item.you ? Palette.accent-background : Palette.foreground.transparentize(0.45);
        }
        Text {
            text: root.item.label;
            width: 44px;
            font-family: Reading.mono;
            font-size: 12px;
            vertical-alignment: center;
            color: Palette.foreground.transparentize(0.25);
            accessible-role: none;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            if root.item.agent: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: at.preferred-width + 12px;
                border-radius: 9px;
                background: #8b5cf6.transparentize(0.8);
                at := Text { text: "agent"; font-size: 10px; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
            }
            Text {
                text: root.item.title;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: Palette.foreground;
                accessible-role: none;
            }
        }
        Rectangle {
            width: 64px;
            CheckBadge { x: 0; y: (parent.height - self.height) / 2; info: root.item.checks; }
        }
        Text {
            text: root.item.you ? "you" : root.item.owner;
            width: 140px;
            overflow: elide;
            vertical-alignment: center;
            font-weight: root.item.you ? 700 : 400;
            color: Palette.foreground.transparentize(0.25);
            accessible-role: none;
        }
        Muted { text: root.item.version; width: 40px; vertical-alignment: center; accessible-role: none; }
        Muted { text: root.item.updated; width: 140px; overflow: elide; vertical-alignment: center; accessible-role: none; }
    }
}

component ShelfFileView inherits Rectangle {
    in property <ShelfFileRow> file;
    height: 28px;
    accessible-role: list-item;
    accessible-label: root.file.path;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        StatusChip { letter: root.file.letter; status: root.file.status; y: (parent.height - self.height) / 2; }
        Text {
            text: root.file.path;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
            color: Palette.foreground;
            accessible-role: none;
        }
    }
}

/// The depot's shelves on top; below, the selected shelf with its checks and files, and its diff.
export component ShelvesView inherits Rectangle {
    probe := Text {
        x: 0;
        y: 0;
        text: "0123456789";
        font-family: Reading.mono;
        font-size: 12px;
        opacity: 0;
        accessible-role: none;
    }
    property <length> char-width: probe.preferred-width / 10;
    VerticalLayout {
        ViewBar {
            title: "Shelves";
            note: Team.shelves.loaded && !Team.shelves.unavailable
                ? Team.shelf-rows.length + (Team.shelves.state == "open" ? " open" : Team.shelves.state == "submitted" ? " submitted" : " deleted")
                : "";
            HorizontalLayout {
                spacing: 4px;
                Chip { y: (parent.height - self.height) / 2; text: "Everyone's"; on: Team.shelves.whose == "all"; clicked => { Team.set-whose("all"); } }
                Chip { y: (parent.height - self.height) / 2; text: "Mine"; on: Team.shelves.whose == "mine"; clicked => { Team.set-whose("mine"); } }
            }
            Rectangle { width: 1px; background: Palette.border; }
            HorizontalLayout {
                spacing: 4px;
                Chip { y: (parent.height - self.height) / 2; text: "Open"; on: Team.shelves.state == "open"; clicked => { Team.set-state("open"); } }
                Chip { y: (parent.height - self.height) / 2; text: "Submitted"; on: Team.shelves.state == "submitted"; clicked => { Team.set-state("submitted"); } }
                Chip { y: (parent.height - self.height) / 2; text: "Deleted"; on: Team.shelves.state == "deleted"; clicked => { Team.set-state("deleted"); } }
            }
            Button { text: "Refresh"; clicked => { Team.refresh-shelves(); } }
        }
        if Team.shelves.error.shown: HorizontalLayout {
            padding: 12px;
            padding-bottom: 0;
            ErrorBanner {
                error: Team.shelves.error;
                dismissable: true;
                dismissed => { Team.dismiss-error(); }
            }
        }
        if Team.shelves.notice != "": HorizontalLayout {
            padding: 12px;
            padding-bottom: 4px;
            Text {
                text: Team.shelves.notice;
                color: #16a34a;
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-role: text;
                accessible-label: "Done";
                accessible-value: self.text;
            }
        }
        if Team.shelves.unavailable: ViewNote {
            text: "This server does not have the shelves module, so changes cannot be shelved here.";
        }
        // The shelves.
        if !Team.shelves.unavailable: VerticalLayout {
            vertical-stretch: 35;
            ColumnBar {
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle { width: 16px; }
                    ColumnName { text: "Shelf"; width: 44px; }
                    ColumnName { text: "Title"; horizontal-stretch: 1; }
                    ColumnName { text: "Checks"; width: 64px; }
                    ColumnName { text: "Owner"; width: 140px; }
                    ColumnName { text: "Ver."; width: 40px; }
                    ColumnName { text: "Updated"; width: 140px; }
                }
            }
            if Team.shelves.loaded && Team.shelf-rows.length == 0: ViewNote {
                text: (Team.shelves.state == "open" ? "No open shelves." : Team.shelves.state == "submitted" ? "No submitted shelves." : "No deleted shelves.")
                    + " Pick files in Changes and press Shelve to share them without committing.";
            }
            ListView {
                vertical-stretch: 1;
                for s in Team.shelf-rows: ShelfRowView { item: s; }
            }
        }
        if !Team.shelves.unavailable: Rectangle { height: 1px; background: Palette.border; }
        // The selected shelf.
        if !Team.shelves.unavailable: HorizontalLayout {
            vertical-stretch: 65;
            Rectangle {
                horizontal-stretch: 2;
                min-width: 340px;
                Rectangle { x: parent.width - 1px; width: 1px; background: Palette.border; }
                if !Team.shelf.shown: Muted {
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    text: "Select a shelf to review it.";
                    wrap: word-wrap;
                }
                if Team.shelf.shown: VerticalLayout {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: Team.shelf.title;
                                font-size: 14px;
                                font-weight: 700;
                                color: Palette.foreground;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                accessible-role: text;
                                accessible-label: "Shelf";
                                accessible-value: self.text;
                            }
                            CopyLinkButton {
                                y: 2px;
                                target: "shelf " + Team.shelf.id;
                                clicked => { Links.copy-shelf(Team.shelf.id); }
                            }
                        }
                        Muted { text: Team.shelf.subtitle; font-size: 12px; }
                        if Team.shelf.body != "": Text { text: Team.shelf.body; wrap: word-wrap; color: Palette.foreground; }
                        HorizontalLayout {
                            spacing: 12px;
                            SmallFact { label: "Owner"; value: Team.shelf.owner; }
                            SmallFact { label: "On"; value: Team.shelf.branch; }
                            SmallFact { label: "Updated"; value: Team.shelf.updated; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if Team.shelf.submitted != "" || Team.shelf.merges != "": HorizontalLayout {
                            spacing: 12px;
                            if Team.shelf.submitted != "": SmallFact { label: "Submitted"; value: Team.shelf.submitted; }
                            if Team.shelf.merges != "": SmallFact { label: "Merges"; value: Team.shelf.merges; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if Team.shelf-checks.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for c in Team.shelf-checks: CheckChip { check: c; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            if Team.shelf.open: Button {
                                text: "Submit…";
                                primary: true;
                                enabled: Team.shelf.busy == "";
                                clicked => { Team.ask-submit(); }
                            }
                            if !Team.shelf.deleted: Button {
                                text: Team.shelf.busy == "Unshelving" ? "Unshelving…" : "Unshelve";
                                enabled: Team.shelf.busy == "";
                                clicked => { Team.unshelve(); }
                            }
                            if Team.shelf.open && Team.shelf.mine: Button {
                                text: "Delete…";
                                accessible-label: "Delete shelf";
                                enabled: Team.shelf.busy == "";
                                clicked => { Team.ask-delete-shelf(); }
                            }
                        }
                    }
                    Rectangle {
                        height: 28px;
                        background: Palette.alternate-background;
                        Rectangle { y: 0; height: 1px; background: Palette.border; }
                        Text {
                            x: 10px;
                            text: "Changed files  " + Team.shelf-files.length;
                            font-weight: 600;
                            font-size: 12px;
                            vertical-alignment: center;
                            color: Palette.foreground.transparentize(0.25);
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for f in Team.shelf-files: ShelfFileView { file: f; }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 3;
                Rectangle {
                    height: 40px;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;
                        Text {
                            text: Team.shelf.shown ? "Changes on the shelf" : "";
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: Palette.foreground;
                        }
                        Chip { y: (parent.height - self.height) / 2; text: "Unified"; on: Team.shelves.layout != "split"; clicked => { Team.set-layout("unified"); } }
                        Chip { y: (parent.height - self.height) / 2; text: "Side by side"; on: Team.shelves.layout == "split"; clicked => { Team.set-layout("split"); } }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: "Shelf diff";
                    for r in Team.shelf-diff: DiffRowView { item: r; char-width: root.char-width; }
                }
            }
        }
    }
}

/// Locks files with an optional comment. A refusal names who holds each file.
export component LockDialog inherits Card {
    callback close();
    width: 480px;
    accessible-role: groupbox;
    accessible-label: "Lock";
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: Team.lock-dialog.title; }
        Muted {
            text: Team.lock-dialog.what + ". Others can read the file but cannot commit it until you unlock it or commit.";
            wrap: word-wrap;
        }
        FormLabel { text: "Comment (optional)"; }
        LineEdit {
            accessible-label: "Comment";
            placeholder-text: "Why you need it, for the others";
            text <=> Team.lock-comment;
            accepted => { Team.submit-lock(); }
        }
        if Team.lock-dialog.error.shown: ErrorBanner { error: Team.lock-dialog.error; }
        if Team.lock-dialog.holders != "": Text {
            text: Team.lock-dialog.holders;
            wrap: word-wrap;
            color: Palette.foreground;
            accessible-role: text;
            accessible-label: "Held by others";
            accessible-value: self.text;
        }
        DialogButtons {
            confirm: Team.lock-dialog.busy ? "Locking…" : "Lock";
            busy: Team.lock-dialog.busy;
            confirmed => { Team.submit-lock(); }
            cancelled => { root.close(); }
        }
    }
}

/// A question with one confirming button (break a lock, delete a shelf).
export component TeamConfirmDialog inherits Card {
    callback close();
    width: 460px;
    accessible-role: groupbox;
    accessible-label: Team.confirm.title;
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Title { text: Team.confirm.title; wrap: word-wrap; }
        Text {
            text: Team.confirm.body;
            wrap: word-wrap;
            color: Palette.foreground;
            accessible-role: text;
            accessible-label: "Question";
            accessible-value: self.text;
        }
        if Team.confirm.error.shown: ErrorBanner { error: Team.confirm.error; }
        DialogButtons {
            confirm: Team.confirm.confirm;
            busy: Team.confirm.busy;
            confirmed => { Team.confirmed(); }
            cancelled => { root.close(); }
        }
    }
}

/// Puts changes on a new shelf, or on an open shelf of mine as its next version.
export component ShelveDialog inherits Card {
    callback close();
    width: 500px;
    accessible-role: groupbox;
    accessible-label: "Shelve";
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: Team.shelve.title; }
        Muted {
            text: "A shelf keeps changes on the server without committing them, so others can review or unshelve them.";
            wrap: word-wrap;
        }
        if Team.shelve-targets.length > 1: VerticalLayout {
            spacing: 4px;
            FormLabel { text: "Put on"; }
            ComboBox {
                model: Team.shelve-targets;
                current-index: Team.shelve-target;
                accessible-label: "Put on";
                selected => { Team.target-chosen(self.current-index); }
            }
            if Team.shelve-target > 0: Muted { text: "Its content is replaced and its version goes up."; font-size: 11px; }
        }
        FormLabel { text: "Description"; }
        TextEdit {
            height: 80px;
            accessible-label: "Description";
            text <=> Team.shelve-text;
        }
        HorizontalLayout {
            spacing: 8px;
            Check {
                checked: Team.shelve-keep;
                accessible-label: "Keep my changes in the workspace";
                toggled => { Team.shelve-keep = !Team.shelve-keep; }
            }
            Text { text: "Keep my changes in the workspace"; color: Palette.foreground; accessible-role: none; }
        }
        if !Team.shelve-keep: Muted { text: "Otherwise the shelved files are reverted here."; font-size: 11px; }
        if Team.shelve.error.shown: ErrorBanner { error: Team.shelve.error; }
        DialogButtons {
            confirm: Team.shelve.busy ? "Shelving…" : Team.shelve-target > 0 ? "Update shelf" : "Shelve";
            busy: Team.shelve.busy;
            enabled: Team.shelve-text != "" || Team.shelve-target > 0;
            confirmed => { Team.submit-shelve(); }
            cancelled => { root.close(); }
        }
    }
}

/// Submits the version of the shelf that was reviewed.
export component SubmitShelfDialog inherits Card {
    callback close();
    width: 500px;
    accessible-role: groupbox;
    accessible-label: "Submit shelf";
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: Team.submit.title; }
        Muted { text: Team.submit.note; wrap: word-wrap; }
        FormLabel { text: "Message"; }
        TextEdit {
            height: 90px;
            accessible-label: "Message";
            text <=> Team.submit-text;
        }
        if Team.submit.error.shown: ErrorBanner { error: Team.submit.error; }
        if Team.submit.missing != "": Text {
            text: Team.submit.missing;
            wrap: word-wrap;
            font-family: Reading.mono;
            color: Palette.foreground;
            accessible-role: text;
            accessible-label: "Missing checks";
            accessible-value: self.text;
        }
        if Team.submit.stale: DialogButtons {
            confirm: "Review the new version";
            confirmed => { Team.review-new-version(); }
            cancelled => { root.close(); }
        }
        if !Team.submit.stale: DialogButtons {
            confirm: Team.submit.busy ? "Submitting…" : "Submit";
            busy: Team.submit.busy;
            enabled: Team.submit-text != "";
            confirmed => { Team.submit-shelf(); }
            cancelled => { root.close(); }
        }
    }
}

/// What an unshelve did to each file.
export component UnshelvedDialog inherits Card {
    callback close();
    width: 460px;
    accessible-role: groupbox;
    accessible-label: Team.unshelved.title;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: Team.unshelved.title; }
        Text { text: Team.unshelved.counts; color: Palette.foreground; }
        Text {
            text: Team.unshelved.files;
            font-family: Reading.mono;
            wrap: word-wrap;
            color: Palette.foreground;
            accessible-role: text;
            accessible-label: "Unshelved files";
            accessible-value: self.text;
        }
        if Team.unshelved.conflicts: Muted {
            text: "Files in conflict show in Changes. Until the app can resolve them, run lode resolve <path> --mine|--theirs|--merged.";
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            Button { text: "Done"; primary: true; clicked => { root.close(); } }
        }
    }
}
