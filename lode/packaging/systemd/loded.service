# systemd unit for the Lode server.
#
# Install (as root):
#   useradd --system --home-dir /var/lib/lode --shell /usr/sbin/nologin lode
#   install -m 0755 loded lode /usr/local/bin/
#   install -d -o lode -g lode -m 0750 /var/lib/lode
#   sudo -u lode loded init /var/lib/lode        # prints the admin token once
#   install -m 0644 loded.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now loded
#
# Logs: journalctl -u loded. Log level: Environment=LODED_LOG=debug below.

[Unit]
Description=Lode version control server
Documentation=https://github.com/hutler/simpledevops/tree/main/lode/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lode
Group=lode
ExecStart=/usr/local/bin/loded serve --config /var/lib/lode/loded.toml
Restart=on-failure
RestartSec=5
# Let in-flight requests finish on stop (loded shuts down gracefully on SIGTERM).
TimeoutStopSec=60
Environment=LODED_LOG=info
LimitNOFILE=65536

# Hardening: the server only needs its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/lode
# Uncomment to bind a port below 1024 (such as 443 with [tls]) without root.
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
