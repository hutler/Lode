{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lode Desk",
  "version": "0.1.0",
  "identifier": "dev.simpledevops.lode-desk",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lode Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lode"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/hutler/Lode/releases/download/lode-desk-feed/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "SimpleDevOps",
    "homepage": "https://github.com/hutler/Lode",
    "copyright": "Copyright the SimpleDevOps contributors",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "The Lode version control desktop client",
    "longDescription": "Lode Desk shows a Lode workspace's changes, history, locks, shelves, branches and view, and runs the same operations as the lode command.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "section": "vcs",
        "desktopTemplate": "packaging/lode-desk.desktop"
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "packaging/lode-desk.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
