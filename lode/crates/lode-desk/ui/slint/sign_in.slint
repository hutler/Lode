// Sign in with a name and password, or through the company's sign-in page when the server
// offers single sign-on. The token goes where `lode login` keeps it, so the command line is
// signed in too.

import { Button, LineEdit, Palette } from "std-widgets.slint";
import { ErrorInfo, ErrorBanner, Card, Muted, Title, FormLabel } from "parts.slint";
import { Logo } from "brand.slint";

export struct SignInState {
    server: string,
    name: string,
    password: string,
    busy: bool,
    error: ErrorInfo,
    /// The provider's label when the server offers single sign-on, else empty.
    sso-label: string,
    /// Whether password sign-in is open to everyone (false: server administrators only).
    password-login: bool,
    /// Waiting for the browser sign-in to finish.
    waiting: bool,
    /// The sign-in address, for when no browser opened.
    sso-url: string,
    /// "Signed in to … as …" once done.
    done: string,
    /// What answers at the address: empty (nothing asked yet), checking, ok or bad.
    probe: string,
    /// The server found, or why none was.
    probe-text: string,
    /// The address to use instead, when the one typed has a path the server is not at.
    suggested: string,
}

/// What answers at the address being typed, under the address.
component ProbeLine inherits Rectangle {
    in property <SignInState> state;
    callback use-suggested();
    property <bool> good: root.state.probe == "ok";
    height: line.preferred-height;
    border-radius: 6px;
    background: root.state.probe == "ok" ? #16a34a1c : root.state.probe == "bad" ? #dc26261c : transparent;
    accessible-role: text;
    accessible-label: "Server check";
    accessible-value: root.state.probe == "checking" ? "Checking the address…" : root.state.probe-text;
    line := HorizontalLayout {
        padding: root.state.probe == "checking" ? 0 : 8px;
        spacing: 8px;
        Text {
            text: root.state.probe == "ok" ? "✓" : root.state.probe == "bad" ? "✕" : "";
            font-weight: 700;
            color: root.good ? #16a34a : #dc2626;
            width: root.state.probe == "checking" ? 0 : self.preferred-width;
            accessible-role: none;
        }
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.state.probe == "checking" ? "Checking the address…" : root.state.probe-text;
                wrap: word-wrap;
                color: root.state.probe == "checking" ? Palette.foreground.transparentize(0.4) : Palette.foreground;
                accessible-role: none;
            }
            if root.state.suggested != "": HorizontalLayout {
                alignment: start;
                Button {
                    text: "Use " + root.state.suggested;
                    primary: true;
                    clicked => { root.use-suggested(); }
                }
            }
        }
    }
}

/// "or with a password" between two rules.
component OrLine inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Palette.border; horizontal-stretch: 1; }
    Muted { text: root.text; font-size: 12px; horizontal-stretch: 0; }
    Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Palette.border; horizontal-stretch: 1; }
}

export component SignInDialog inherits Card {
    in-out property <SignInState> state;
    callback server-edited(string);
    callback submit();
    callback sso();
    callback close();
    property <bool> blocked: root.state.probe == "bad";
    width: 460px;
    accessible-role: groupbox;
    accessible-label: "Sign in";
    VerticalLayout {
        // The header: the app's mark and what this signs in to.
        Rectangle {
            height: head.preferred-height;
            head := HorizontalLayout {
                padding: 20px;
                padding-bottom: 14px;
                spacing: 12px;
                Logo { size: 36px; y: (parent.height - self.height) / 2; }
                VerticalLayout {
                    alignment: center;
                    Title { text: "Sign in to a Lode server"; font-size: 18px; }
                    Muted { text: "Lode Desk and the lode command share this sign-in."; font-size: 12px; }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
        }
        if root.state.done != "": VerticalLayout {
            padding: 20px;
            spacing: 16px;
            Text {
                text: root.state.done;
                wrap: word-wrap;
                color: Palette.foreground;
                accessible-role: text;
                accessible-label: "Signed in";
                accessible-value: self.text;
            }
            HorizontalLayout {
                alignment: end;
                Button { text: "Done"; primary: true; clicked => { root.close(); } }
            }
        }
        if root.state.done == "": VerticalLayout {
            padding: 20px;
            padding-top: 16px;
            spacing: 8px;
            FormLabel { text: "Server address"; }
            server-input := LineEdit {
                accessible-label: "Server";
                placeholder-text: "https://lode.example.com";
                text: root.state.server;
                enabled: !root.state.busy;
                edited(t) => { root.state.server = t; root.server-edited(t); }
                accepted => { root.submit(); }
            }
            if root.state.probe != "": ProbeLine {
                state: root.state;
                use-suggested => {
                    server-input.text = root.state.suggested;
                    root.state.server = root.state.suggested;
                    root.server-edited(root.state.suggested);
                }
            }
            if root.state.sso-label != "": VerticalLayout {
                spacing: 8px;
                padding-top: 4px;
                Button {
                    text: "Sign in with " + root.state.sso-label;
                    primary: true;
                    enabled: !root.state.busy;
                    clicked => { root.sso(); }
                }
                if root.state.waiting: Text {
                    text: root.state.sso-url == ""
                        ? "Finish signing in in your browser."
                        : "Finish signing in in your browser. If it did not open, open this address on this computer: " + root.state.sso-url;
                    wrap: word-wrap;
                    color: Palette.foreground;
                    accessible-role: text;
                    accessible-label: "Browser sign-in";
                    accessible-value: self.text;
                }
                if root.state.password-login: OrLine { text: "or with a password"; }
                if !root.state.password-login: Muted {
                    text: "Password sign-in is for server administrators only.";
                    wrap: word-wrap;
                }
            }
            FormLabel { text: "Name"; }
            LineEdit {
                accessible-label: "Name";
                text: root.state.name;
                enabled: !root.state.busy;
                edited(t) => { root.state.name = t; }
                accepted => { root.submit(); }
            }
            FormLabel { text: "Password"; }
            LineEdit {
                accessible-label: "Password";
                input-type: password;
                text: root.state.password;
                enabled: !root.state.busy;
                edited(t) => { root.state.password = t; }
                accepted => { root.submit(); }
            }
            if root.state.error.shown: ErrorBanner { error: root.state.error; }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 4px;
                Muted {
                    text: root.blocked ? "Fix the address to sign in." : "";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-size: 12px;
                }
                Button { text: "Cancel"; enabled: !root.state.busy || root.state.waiting; clicked => { root.close(); } }
                Button {
                    text: root.state.busy && !root.state.waiting ? "Signing in…" : "Sign in";
                    primary: root.state.sso-label == "";
                    enabled: !root.state.busy && !root.blocked;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}
