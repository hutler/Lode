// `lode://` links (T135): copying a link to a revision, a file or a shelf, and the dialogs for a
// link handed to the app: refused, which workspace, or none yet. The rules are in src/links.rs;
// src/app/outside.rs decides which dialog shows.

import { Button, ListView, Palette } from "std-widgets.slint";
import { Card, Muted, Title, Badge } from "parts.slint";

/// A workspace that can open the link.
export struct LinkChoice {
    path: string,
    branch: string,
    open: bool,
}

/// The link the dialogs are about.
export struct LinkState {
    /// The link as given (refused links).
    text: string,
    /// Why it was refused, as a sentence.
    why: string,
    /// What it points at, in words: "r42", "Content/a.txt at r3", "shelf 7".
    target: string,
    depot: string,
    host: string,
}

export global Links {
    in-out property <LinkState> link;
    in property <[LinkChoice]> choices;
    /// What was copied last, as `target` names it ("" when the note has gone); its button
    /// says "Copied" for a moment.
    in-out property <string> copied;
    /// The link copied last, as text.
    in-out property <string> copied-link;
    /// A note above the workspace after a link opened in it.
    in-out property <string> notice;
    callback pick(string);
    callback check-out();
    callback copy-revision(int);
    callback copy-file(string, int);
    callback copy-shelf(int);
    callback close();
}

/// "Copy link", then "Copied" for a moment.
export component CopyLinkButton inherits Rectangle {
    /// What the link points at, as `Links.copied` names it.
    in property <string> target;
    in property <string> text: "Copy link";
    callback clicked();
    height: t.preferred-height;
    width: t.preferred-width;
    accessible-role: button;
    accessible-label: "Copy link to " + root.target;
    accessible-action-default => { root.clicked(); }
    TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    t := Text {
        text: Links.copied == root.target ? "Copied" : root.text;
        color: Palette.accent-background;
        accessible-role: none;
    }
}

export component RefusedLinkDialog inherits Card {
    width: 480px;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: "This link cannot be opened"; }
        Muted { text: Links.link.text; wrap: word-wrap; font-family: "monospace"; }
        Text {
            text: Links.link.why + " Nothing was opened.";
            wrap: word-wrap;
            color: Palette.foreground;
            accessible-role: text;
            accessible-label: "Why";
            accessible-value: self.text;
        }
        HorizontalLayout {
            alignment: end;
            Button { text: "OK"; primary: true; clicked => { Links.close(); } }
        }
    }
}

component ChoiceRow inherits Rectangle {
    in property <LinkChoice> item;
    height: 48px;
    background: touch.has-hover ? Palette.alternate-background : transparent;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: "Open in " + root.item.path;
    accessible-action-default => { Links.pick(root.item.path); }
    touch := TouchArea { clicked => { Links.pick(root.item.path); } }
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        Text {
            text: root.item.path;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: Palette.foreground;
            accessible-role: none;
        }
        Badge { y: (parent.height - self.height) / 2; text: root.item.branch; }
        if root.item.open: Muted { text: "open"; vertical-alignment: center; accessible-role: none; }
    }
}

export component ChooseWorkspaceDialog inherits Card {
    width: 520px;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: "Open the link in which workspace?"; }
        Text {
            text: "Several workspaces of " + Links.link.depot + " on " + Links.link.host + " can show " + Links.link.target + ".";
            wrap: word-wrap;
            color: Palette.foreground;
        }
        ListView {
            height: min(Links.choices.length * 48px, 240px);
            for c in Links.choices: ChoiceRow { item: c; }
        }
        HorizontalLayout {
            alignment: end;
            Button { text: "Cancel"; clicked => { Links.close(); } }
        }
    }
}

export component NoWorkspaceDialog inherits Card {
    width: 480px;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Title { text: "No workspace for this link"; }
        Text {
            text: "The link shows " + Links.link.target + " in " + Links.link.depot + " on " + Links.link.host
                + ", and no open or recent workspace is of that depot. Check it out to open the link.";
            wrap: word-wrap;
            color: Palette.foreground;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { Links.close(); } }
            Button { text: "Check out " + Links.link.depot + "…"; primary: true; clicked => { Links.check-out(); } }
        }
    }
}
